# Docker Compose: copy to .env (optional; these defaults already work).
APP_PORT=3000
MONGODB_DB=yelp_analytics
# Folder containing the five extracted yelp_academic_dataset_*.json files.
YELP_DATA_DIR=./data

# Only for running Next.js outside Docker: copy to .env.local.
# Compose always connects the app to its internal mongo service.
MONGODB_URI=mongodb://127.0.0.1:27017
