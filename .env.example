# ReviewScope environment configuration (safe to commit).
# Copy this file to .env.local and adjust values for your machine.
#
# These are SERVER-ONLY variables. Never prefix them with NEXT_PUBLIC_ —
# the MongoDB connection string must never reach the browser.

# MongoDB connection URI for your local server.
MONGODB_URI=mongodb://127.0.0.1:27017

# Database that holds the imported Yelp Open Dataset collections.
MONGODB_DB=yelp_analytics
